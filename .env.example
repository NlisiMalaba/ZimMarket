# =============================================================================
# ZimMarket — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# Docker Compose reads this file for variable substitution; `env_file` passes
# the same entries into containers. ASP.NET Core maps `Section__Key` to JSON.
# =============================================================================

# --- Host / ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
# API listen port (host → container 8080)
API_PORT=8080
# Dev-only: expose Postgres/Redis to the host (see docker-compose.override.yml)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- PostgreSQL (Docker Compose + connection string below) ---
DB_NAME=zimmarket
DB_USER=zim
DB_PASSWORD=change-me
# EF Core / Npgsql — use `postgres` as host when running inside Compose
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=zimmarket;Username=zim;Password=change-me

# --- Redis (cache, sessions; StackExchange.Redis format) ---
REDIS_PASSWORD=change-me
Redis__Configuration=redis:6379,password=change-me,ssl=false,abortConnect=false

# --- JWT (bearer tokens; use strong secrets in production) ---
Jwt__Issuer=ZimMarket
Jwt__Audience=ZimMarket.Api
# Symmetric signing (HS256). For RS256, prefer Azure Key Vault / mounted keys instead.
Jwt__SigningKey=minimum-32-characters-secret-change-me!!
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# --- Azure Blob Storage (uploads / KYC documents) ---
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AzureStorage__UploadsContainer=zimmarket-uploads

# --- Twilio (SMS OTP / notifications) ---
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromPhoneNumber=

# --- SendGrid (transactional email) ---
SendGrid__ApiKey=
SendGrid__DefaultFromEmail=noreply@example.com
SendGrid__DefaultFromName=ZimMarket

# --- Paynow (USD / ZWL card & ZIPIT; primary gateway) ---
Paynow__IntegrationId=
Paynow__IntegrationKey=
Paynow__ReturnUrl=https://api.example.com/api/v1/payments/paynow/return
Paynow__ResultUrl=https://api.example.com/api/v1/payments/webhooks/paynow

# --- Ecocash (mobile money; secondary gateway) ---
Ecocash__MerchantCode=
Ecocash__MerchantKey=
Ecocash__CallbackUrl=https://api.example.com/api/v1/payments/webhooks/ecocash

# --- Firebase Cloud Messaging (push notifications) ---
# Option A: path to service-account JSON (also set GOOGLE_APPLICATION_CREDENTIALS if using Admin SDK defaults)
Firebase__CredentialPath=
Firebase__ProjectId=
# Option B: inline JSON is discouraged in env files; prefer mounted secret files in production.
GOOGLE_APPLICATION_CREDENTIALS=
