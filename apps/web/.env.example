# Backend API — set when you add data fetching (same as admin / mobile)
# NEXT_PUBLIC_API_URL=http://localhost:8080

# This storefront’s public URL (optional; used for canonicals when set)
# NEXT_PUBLIC_CUSTOMER_SITE_URL=https://www.zimmarket.com

# Subdomains for seller & driver portals (required in production)
NEXT_PUBLIC_SELLER_SITE_URL=http://localhost:3001
NEXT_PUBLIC_DRIVER_SITE_URL=http://localhost:3002
